        <div class="tea-newsletter-wrap">
            <div>
                <p class="tea-eyebrow">Newsletter</p>
                <h2>Get Tea Updates and Offers</h2>
                <p class="mb-0">Subscribe for product launches, estate stories, and special discounts.</p>
            </div>
            <form class="tea-newsletter-form" onsubmit="event.preventDefault(); showToast('Thanks for subscribing.', 'success');">
                <input type="email" placeholder="Enter your email address" aria-label="Email address" required>
