@{
    ViewData["Title"] = "About";
    ViewData["BodyClass"] = "about-page";
}

<section class="tea-about-hero section-block">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <p class="tea-eyebrow">About SmartTeaShop</p>
                <h1 class="tea-about-title">Pure Ceylon Tea, built for quality and traceability</h1>
                <p class="tea-about-lead">
                    SmartTeaShop combines a modern tea eCommerce experience with inventory visibility for tea supply chains.
                    We source carefully, track quality closely, and deliver fresh tea products with consistency.
                </p>
                <div class="tea-about-cta">
                    <a href="/Products" class="btn btn-primary rounded-pill">Shop Collection</a>
                    <a href="/Suppliers" class="btn btn-outline-primary rounded-pill">Supplier Network</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="tea-about-panel">
                    <div class="tea-about-stat">
                        <span>25+</span>
                        <small>Years in tea industry</small>
                    </div>
                    <div class="tea-about-stat">
                        <span>100%</span>
                        <small>Ceylon tea focused</small>
                    </div>
                    <div class="tea-about-stat">
                        <span>Real-Time</span>
                        <small>Inventory visibility support</small>
                    </div>
                    <div class="tea-about-stat">
                        <span>Nationwide</span>
                        <small>Delivery across Sri Lanka</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="tea-about-values section-block">
    <div class="container">
        <div class="tea-section-head text-center">
            <p class="tea-eyebrow">Our Values</p>
            <h2>What guides our tea business</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <article class="tea-value-card">
                    <i class="icon-badge icons"></i>
                    <h3>Quality First</h3>
                    <p>Every batch is selected for freshness, aroma, and consistency before it reaches customers.</p>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="tea-value-card">
                    <i class="icon-refresh icons"></i>
                    <h3>Reliable Operations</h3>
                    <p>Inventory and delivery processes are designed to reduce stockouts and order delays.</p>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="tea-value-card">
                    <i class="icon-globe icons"></i>
                    <h3>Responsible Sourcing</h3>
                    <p>We work with trusted suppliers and support transparent tea supply-chain practices.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="tea-about-journey section-block">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7">
                <div class="tea-journey-card">
                    <h2>Our Journey</h2>
                    <p>
                        Starting from a local tea business, SmartTeaShop evolved into a data-driven platform where online sales,
                        supplier operations, and inventory management work together.
                    </p>
                    <p>
                        The system now supports QR-based supplier and stock workflows, allowing operational teams to maintain
                        cleaner records and faster decision-making.
                    </p>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="tea-journey-list">
                    <div>
                        <strong>1998</strong>
                        <span>Started tea trading operations</span>
                    </div>
                    <div>
                        <strong>2012</strong>
                        <span>Expanded retail product lines</span>
                    </div>
                    <div>
                        <strong>2026</strong>
                        <span>Launched predictive tea inventory platform</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
