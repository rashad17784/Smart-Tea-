@{
    ViewData["Title"] = "Privacy";
    ViewData["BodyClass"] = "privacy-page";
}

<section class="tea-privacy-section section-block">
    <div class="container">
        <div class="tea-privacy-card">
            <p class="tea-eyebrow">Policy</p>
            <h1>Privacy Policy</h1>
            <p>
                SmartTeaShop protects user data and uses it only for order processing, account management,
                service communication, and operational analytics within the tea inventory and sales system.
            </p>

            <h3>Information We Use</h3>
            <ul>
                <li>Account details such as name, email, and role.</li>
                <li>Order and delivery details required to fulfill purchases.</li>
                <li>System activity data for reliability, security, and reporting.</li>
            </ul>

            <h3>How We Protect Data</h3>
            <ul>
                <li>Role-based access controls for administrative features.</li>
                <li>Secure database connections and validated input flows.</li>
                <li>Limited access to operational records based on user permissions.</li>
            </ul>

            <h3>Contact</h3>
            <p>
                For privacy-related questions, contact the SmartTeaShop support team through your system administrator.
            </p>
        </div>
    </div>
</section>
