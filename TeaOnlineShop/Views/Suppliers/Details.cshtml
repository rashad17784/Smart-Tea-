@model TeaOnlineShop.Models.Dbase.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4>@ViewData["Title"]</h4>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm">
                    <i class="icon-pencil icons"></i> Edit
                </a>
                <a asp-controller="Deliveries" asp-action="Create" asp-route-supplierId="@Model.Id" class="btn btn-success btn-sm">
                    <i class="icon-note icons"></i> Record Delivery
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-5">
                    <h5 class="border-bottom pb-2">Basic Information</h5>
                    <dl class="row mt-3">
                        <dt class="col-sm-4">Code</dt>
                        <dd class="col-sm-8">@Model.SupplierCode</dd>
                        
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                        
                        <dt class="col-sm-4">Contact Person</dt>
                        <dd class="col-sm-8">@(Model.ContactPerson ?? "N/A")</dd>
                        
                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@(Model.Phone ?? "N/A")</dd>
                        
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@(Model.Email ?? "N/A")</dd>
                        
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@(Model.Address ?? "N/A")</dd>
                        
                        <dt class="col-sm-4">Registered On</dt>
                        <dd class="col-sm-8">@Model.RegistrationDate.ToString("yyyy-MM-dd")</dd>
                        
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>
                        
                        <dt class="col-sm-4">Notes</dt>
                        <dd class="col-sm-8">@(Model.Notes ?? "N/A")</dd>
                    </dl>
                    
                    <h5 class="border-bottom pb-2 mt-4">Categories</h5>
                    <div class="mt-3">
                        @if (ViewBag.Categories != null && ViewBag.Categories.Count > 0)
                        {
                            @foreach (var category in ViewBag.Categories)
                            {
                                <span class="badge bg-info me-2 mb-2">@category.Name</span>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No categories assigned</p>
                        }
                    </div>
                </div>
                <div class="col-md-7">
                    <h5 class="border-bottom pb-2">QR Code</h5>
                    <div class="mt-4 text-center">
                        @if (!string.IsNullOrEmpty(ViewBag.QRCodeImageUrl))
                        {
                            <img src="@ViewBag.QRCodeImageUrl" alt="QR Code" class="img-fluid border p-2" style="max-width: 250px;" />
                            <p class="mt-2 small text-muted">@Model.QRCodeData</p>
                        }
                        else
                        {
                            <p class="text-muted">QR Code not available</p>
                        }
                    </div>
                    
                    <h5 class="border-bottom pb-2 mt-4">Recent Deliveries</h5>
                    <div class="mt-3">
                        <div class="text-center py-4">
                            <p class="text-muted">View recent deliveries functionality will be added soon.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="icon-arrow-left icons"></i> Back to List
            </a>
        </div>
    </div>
</div> 