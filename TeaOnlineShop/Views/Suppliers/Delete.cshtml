@model TeaOnlineShop.Models.Dbase.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="icon-exclamation icons"></i> Are you sure you want to delete this supplier? This action cannot be undone.
            </div>
            
            <h5 class="border-bottom pb-2">Supplier Details</h5>
            <dl class="row mt-3">
                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9">@Model.SupplierCode</dd>
                
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                
                <dt class="col-sm-3">Contact Person</dt>
                <dd class="col-sm-9">@(Model.ContactPerson ?? "N/A")</dd>
                
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@(Model.Phone ?? "N/A")</dd>
                
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(Model.Email ?? "N/A")</dd>
                
                <dt class="col-sm-3">Registered On</dt>
                <dd class="col-sm-9">@Model.RegistrationDate.ToString("yyyy-MM-dd")</dd>
                
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.Status == "Active")
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
            </dl>
            
            <div class="mt-4">
                <p class="text-danger">
                    <strong>Note:</strong> If this supplier has existing deliveries, it will be marked as inactive instead of being deleted.
                </p>
            </div>
            
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="icon-arrow-left icons"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="icon-trash icons"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div> 