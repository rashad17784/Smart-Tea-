@model TeaOnlineShop.Models.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="SupplierCode" class="form-label"></label>
                            <input asp-for="SupplierCode" class="form-control" readonly />
                            <span asp-validation-for="SupplierCode" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="ContactPerson" class="form-label"></label>
                            <input asp-for="ContactPerson" class="form-control" />
                            <span asp-validation-for="ContactPerson" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" type="tel" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="RegistrationDate" class="form-label"></label>
                            <input asp-for="RegistrationDate" class="form-control" type="date" />
                            <span asp-validation-for="RegistrationDate" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label asp-for="SelectedCategoryIds" class="form-label"></label>
                    <div class="row">
                        @foreach (var category in Model.AvailableCategories)
                        {
                            <div class="col-md-4 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" 
                                           value="@category.Value" id="category_@category.Value"
                                           @(Model.SelectedCategoryIds.Contains(int.Parse(category.Value)) ? "checked" : "")>
                                    <label class="form-check-label" for="category_@category.Value">
                                        @category.Text
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.QRCodeImageUrl))
                {
                    <div class="mb-4">
                        <h5>QR Code</h5>
                        <div class="text-center">
                            <img src="@Model.QRCodeImageUrl" alt="QR Code" class="img-fluid border p-2" style="max-width: 200px;" />
                            <p class="small text-muted mt-2">@Model.QRCodeData</p>
                        </div>
                    </div>
                }
                
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="icon-arrow-left icons"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="icon-check icons"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 