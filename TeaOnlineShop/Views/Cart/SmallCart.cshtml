@using System.IO
@model List<TeaOnlineShop.Models.ViewModels.ProductCartViewModel>
@{
    const string fallbackImage = "/images/placeholder-tea.svg";
    string SafeImagePath(string? rawName)
    {
        var fileName = System.IO.Path.GetFileName(rawName ?? string.Empty);
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return fallbackImage;
        }

        return $"/images/banners/{fileName}";
    }
}

@if (Model != null && Model.Any())
{
    <div class="cart_gallery">
        <div class="cart_close">
            <div class="cart_text">
                <h3>Cart</h3>
            </div>
            <div class="mini_cart_close">
                <a href="javascript:void(0)"><i class="icon-close icons"></i></a>
            </div>
        </div>

        @foreach (var item in Model)
        {
            var imagePath = SafeImagePath(item.ImageName);
            <div class="cart_item">
                <div class="cart_img">
                    <a href="/Products/ProductDetails/@item.Id">
                        <img src="@imagePath" alt="@item.Title" onerror="this.onerror=null;this.src='@fallbackImage';">
                    </a>
                </div>
                <div class="cart_info">
                    <a href="/Products/ProductDetails/@item.Id">@item.Title</a>
                    <p>@item.Count x <span>$@item.Price.GetValueOrDefault(0).ToString("F2")</span></p>
                </div>
                <div class="cart_remove">
                    <a onclick="updateCart(@item.Id, 0)"><i class="icon-close icons"></i></a>
                </div>
            </div>
        }
    </div>

    <div class="mini_cart_table">
        <div class="cart_table_border">
            <div class="cart_total mt-10">
                <span>Total:</span>
                <span class="Price">$@Model.Sum(x => x.RowSumPrice).GetValueOrDefault(0).ToString("F2")</span>
            </div>
        </div>
    </div>

    <script>
        $(".item_count").html(@Model.Sum(x => x.Count));
    </script>
}

<div class="mini_cart_footer">
    <div class="cart_button">
        <a href="/Cart"><i class="fa fa-shopping-cart"></i> View Cart</a>
    </div>
    <div class="cart_button">
        <a href="/Cart/Checkout"><i class="fa fa-sign-in"></i> Checkout</a>
    </div>
</div>

