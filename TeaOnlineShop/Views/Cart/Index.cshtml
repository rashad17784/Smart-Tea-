@using System.IO
@model List<TeaOnlineShop.Models.ViewModels.ProductCartViewModel>
@{
    ViewData["Title"] = "Shopping Cart";
    ViewData["BodyClass"] = "cart-page";
    var cartItems = Model ?? new List<TeaOnlineShop.Models.ViewModels.ProductCartViewModel>();
    decimal subtotal = cartItems.Sum(x => x.RowSumPrice ?? 0);

    const string fallbackImage = "/images/placeholder-tea.svg";
    string SafeImagePath(string? rawName)
    {
        var fileName = System.IO.Path.GetFileName(rawName ?? string.Empty);
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return fallbackImage;
        }

        return $"/images/banners/{fileName}";
    }
}

<section class="cart-modern-wrapper pb-5">
    <div class="container">
        <div class="cart-page-head">
            <h1>Your Cart</h1>
            <p>Review your selected tea products before checkout.</p>
        </div>

        @if (cartItems.Any())
        {
            @if (ViewData["StockAdjustmentMessage"] is string stockAdjustmentMessage)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    @stockAdjustmentMessage
                </div>
            }

            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <div class="cart-table-card">
                        <div class="table-responsive">
                            <table class="table modern-cart-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cartItems)
                                    {
                                        var imagePath = SafeImagePath(item.ImageName);
                                        <tr id="@item.Id">
                                            <td>
                                                <div class="cart-product-cell">
                                                    <img src="@imagePath" alt="@item.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
                                                    <div>
                                                        <h5>@item.Title</h5>
                                                        <a href="/Products/ProductDetails/@item.Id">View product</a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">$@((item.Price ?? 0).ToString("F2"))</td>
                                            <td class="text-center">
                                                <input class="modern-qty-input"
                                                       min="1"
                                                       max="@item.AvailableQuantity"
                                                       type="number"
                                                       value="@item.Count"
                                                       aria-label="Quantity for @item.Title"
                                                       onchange="updateCart(@item.Id, this.value, this)" />
                                                <small class="d-block text-muted mt-1">
                                                    @item.AvailableQuantity available
                                                </small>
                                            </td>
                                            <td class="text-end fw-bold">$@((item.RowSumPrice ?? 0).ToString("F2"))</td>
                                            <td class="text-center">
                                                <button type="button" class="remove-row-btn" onclick="updateCart(@item.Id,0)">
                                                    <i class="ion-android-close"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="cart-actions-row">
                        <a href="/Products" class="btn btn-outline-primary rounded-pill">Continue Shopping</a>
                        <div class="d-flex gap-2">
                            <a href="/Cart" class="btn btn-outline-secondary rounded-pill">Refresh Cart</a>
                            <a href="/Cart/ClearCart" class="btn btn-outline-danger rounded-pill">Clear Cart</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <aside class="cart-summary-card">
                        <h4>Order Summary</h4>
                        <div class="summary-row">
                            <span>Items</span>
                            <span>@cartItems.Sum(x => x.Count)</span>
                        </div>
                        <div class="summary-row summary-total">
                            <span>Subtotal</span>
                            <span>$@subtotal.ToString("F2")</span>
                        </div>
                        <a class="btn btn-primary w-100 rounded-pill" href="/Cart/Checkout">Proceed to Checkout</a>
                        <p class="summary-note">Shipping and tax are calculated at checkout.</p>
                    </aside>
                </div>
            </div>
        }
        else
        {
            <div class="empty-cart-card">
                <h3>Your cart is empty</h3>
                <p>Add products from the shop to start your order.</p>
                <a class="btn btn-primary rounded-pill" href="/Products">Go to Shop</a>
            </div>
        }
    </div>
</section>

