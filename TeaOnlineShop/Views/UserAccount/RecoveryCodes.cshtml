@model TeaOnlineShop.Models.ViewModels.RecoveryCodesViewModel
@{
    ViewData["Title"] = "MFA recovery codes";
    ViewData["BodyClass"] = "auth-page";
}

<section class="tea-auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-9">
                <div class="tea-auth-card">
                    <div class="tea-auth-head text-center">
                        <p class="tea-eyebrow">Administrator Security</p>
                        <h1>Store your recovery codes</h1>
                        <p>Each code can be used once. Store them offline in a secure password vault.</p>
                    </div>
                    <div class="alert alert-warning">These codes will not be displayed again.</div>
                    <div class="row g-2 mb-4">
                        @foreach (var code in Model.RecoveryCodes)
                        {
                            <div class="col-6"><code class="d-block border rounded p-2 text-center">@code</code></div>
                        }
                    </div>
                    <a href="/Admin" class="btn btn-primary w-100 rounded-pill">Continue to Staff Area</a>
                </div>
            </div>
        </div>
    </div>
</section>
