@model IEnumerable<TeaOnlineShop.Models.Dbase.SupplyItem>

@{
    ViewData["Title"] = "Supply Items";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Supply Items</h4>
            <div>
                <a href="/Deliveries/CreateSupplyItem" class="btn btn-light btn-sm" style="z-index: 100; position: relative;">
                    <i class="icon-plus icons"></i> Add New Item
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Current Stock</th>
                            <th>Minimum Stock</th>
                            <th>Status</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Category</td>
                                    <td>@item.Unit</td>
                                    <td>@item.CurrentStock</td>
                                    <td>@(item.MinimumStock?.ToString() ?? "N/A")</td>
                                    <td>
                                        @if (item.MinimumStock.HasValue && item.CurrentStock < item.MinimumStock)
                                        {
                                            <span class="badge bg-danger">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                    </td>
                                    <td>@(item.Description ?? "N/A")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted mb-0">No supply items found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-md-6">
                    <a href="/Deliveries/Index" class="btn btn-outline-secondary" style="z-index: 100; position: relative;">
                        <i class="icon-arrow-left icons"></i> Back to Deliveries
                    </a>
                </div>
                <div class="col-md-6 text-end">
                    <div class="text-muted small">
                        <i class="icon-info icons"></i> Items with stock levels below minimum are marked in red.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Force the Add New Item button to be clickable
            $('.btn-light.btn-sm, .btn-outline-secondary').on('click', function(e) {
                var href = $(this).attr('href');
                if (href) {
                    window.location.href = href;
                }
            });
            
            // Disable any parent event handlers that might be intercepting clicks
            $('.btn-light.btn-sm, .btn-outline-secondary').parent().on('click', function(e) {
                e.stopPropagation();
            });
            
            console.log("Supply Items buttons initialized");
        });
    </script>
} 