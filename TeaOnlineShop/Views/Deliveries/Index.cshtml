@model IEnumerable<TeaOnlineShop.Models.Dbase.Delivery>

@{
    ViewData["Title"] = "Deliveries";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Deliveries</h4>
            <div>
                <a href="/Deliveries/ScanSupplier" class="btn btn-info btn-sm text-white" style="z-index: 100; position: relative;">
                    <i class="icon-camera icons"></i> Scan Supplier
                </a>
                <a href="/Deliveries/Create" class="btn btn-light btn-sm" style="z-index: 100; position: relative;">
                    <i class="icon-plus icons"></i> Record Delivery
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info mb-3">
                    @TempData["Message"]
                </div>
            }
            
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Delivery Code</th>
                            <th>Supplier</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Total Amount</th>
                            <th>Received By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DeliveryCode</td>
                                    <td>@item.Supplier.Name</td>
                                    <td>@item.DeliveryDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (item.Status == "Received")
                                        {
                                            <span class="badge bg-success">Received</span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                    </td>
                                    <td>$@(item.TotalAmount?.ToString("0.00") ?? "0.00")</td>
                                    <td>@item.ReceivedByName</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/Deliveries/Details/@item.Id" class="btn btn-outline-primary" style="z-index: 100; position: relative;">
                                                <i class="icon-eye icons"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted mb-0">No deliveries found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <a href="/Deliveries/SupplyItems" class="btn btn-outline-primary" style="z-index: 100; position: relative;">
                <i class="icon-layers icons"></i> Manage Supply Items
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Force the buttons to be clickable
            $('.btn-info.btn-sm, .btn-light.btn-sm, .btn-outline-primary').on('click', function(e) {
                var href = $(this).attr('href');
                if (href) {
                    window.location.href = href;
                }
            });
            
            // Disable any parent event handlers that might be intercepting clicks
            $('.btn-info.btn-sm, .btn-light.btn-sm, .btn-outline-primary').parent().on('click', function(e) {
                e.stopPropagation();
            });
            
            console.log("Deliveries buttons initialized");
        });
    </script>
} 
