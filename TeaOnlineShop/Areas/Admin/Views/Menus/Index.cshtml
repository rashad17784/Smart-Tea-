@model IEnumerable<TeaOnlineShop.Models.Dbase.Menu>

@{
    ViewData["Title"] = "Menu Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-list me-2"></i>Menu Management</h2>
    <a href="/Admin/Menus/Create" class="btn btn-primary">
        <i class="fa fa-plus me-2"></i>Add New Menu Item
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">All Menu Items</h5>
            <div>
                <input type="text" id="menuSearch" class="form-control form-control-sm" placeholder="Search menus..." style="width: 200px;">
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 table-admin">
                <thead>
                    <tr>
                        <th style="width: 30%">
                            <i class="fa fa-tag me-2 text-muted"></i>@Html.DisplayNameFor(model => model.MenuTitle)
                        </th>
                        <th style="width: 40%">
                            <i class="fa fa-link me-2 text-muted"></i>@Html.DisplayNameFor(model => model.Link)
                        </th>
                        <th style="width: 15%">
                            <i class="fa fa-sitemap me-2 text-muted"></i>@Html.DisplayNameFor(model => model.Type)
                        </th>
                        <th style="width: 15%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>
                            <span class="fw-medium">@Html.DisplayFor(modelItem => item.MenuTitle)</span>
                        </td>
                        <td>
                            <code>@Html.DisplayFor(modelItem => item.Link)</code>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.Type)</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end action-buttons">
                                <a href="/Admin/Menus/Edit/@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                    <i class="fa fa-pencil-alt"></i>
                                </a>
                                <a href="/Admin/Menus/Details/@item.Id" class="btn btn-sm btn-outline-info me-1" title="Details">
                                    <i class="fa fa-info-circle"></i>
                                </a>
                                <a href="/Admin/Menus/Delete/@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <small class="text-muted">Showing @Model.Count() menu items</small>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filter table as user types in search box
            $("#menuSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
