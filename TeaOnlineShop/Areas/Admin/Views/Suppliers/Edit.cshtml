@model TeaOnlineShop.Models.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-truck me-2"></i>Edit Supplier</h2>
    <div>
        <a asp-area="Admin" asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Supplier Information</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Suppliers" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="QRCodeData" />
            <input type="hidden" asp-for="RegistrationDate" />
            
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="SupplierCode" class="form-label">Supplier Code</label>
                        <input asp-for="SupplierCode" class="form-control" readonly />
                        <span asp-validation-for="SupplierCode" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="ContactPerson" class="form-label">Contact Person</label>
                        <input asp-for="ContactPerson" class="form-control" />
                        <span asp-validation-for="ContactPerson" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SelectedCategoryIds" class="form-label">Categories</label>
                        <select asp-for="SelectedCategoryIds" asp-items="Model.AvailableCategories" class="form-select" multiple>
                        </select>
                        <span asp-validation-for="SelectedCategoryIds" class="text-danger"></span>
                        <small class="text-muted">Hold Ctrl/Cmd to select multiple categories</small>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Address" class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label class="form-label">Registration Date</label>
                        <input value="@Model.RegistrationDate.ToString("yyyy-MM-dd")" class="form-control" readonly />
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">QR Code</h5>
    </div>
    <div class="card-body text-center">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@Model.QRCodeData" alt="Supplier QR Code" class="img-fluid border p-2" />
        <p class="mt-3 mb-0">Scan this QR code to quickly identify this supplier</p>
        <p class="text-muted">QR Code Value: @Model.QRCodeData</p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 