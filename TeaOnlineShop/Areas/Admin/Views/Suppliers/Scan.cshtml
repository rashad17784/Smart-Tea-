@model TeaOnlineShop.Models.ViewModels.QRScanViewModel

@{
    ViewData["Title"] = "Scan Supplier QR Code";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-qrcode me-2"></i>Scan Supplier QR Code</h2>
    <div>
        <a asp-area="Admin" asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Camera Feed</h5>
            </div>
            <div class="card-body text-center">
                <div id="qr-reader" style="width: 100%; max-width: 500px; margin: 0 auto;"></div>
                <div id="qr-reader-results" class="mt-3"></div>
                
                <div class="alert alert-info mt-3">
                    <p class="mb-0">
                        <i class="fa fa-info-circle me-2"></i>
                        Point your camera at a supplier QR code to quickly find a supplier.
                    </p>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between">
                    <button id="startButton" class="btn btn-primary">
                        <i class="fa fa-camera me-2"></i>Start Scanner
                    </button>
                    <button id="stopButton" class="btn btn-secondary" disabled>
                        <i class="fa fa-stop me-2"></i>Stop Scanner
                    </button>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Manual Entry</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Suppliers" asp-action="FindByCode" method="get">
                    <div class="input-group mb-3">
                        <input type="text" id="supplierCode" name="code" class="form-control" placeholder="Enter supplier code..." />
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="fa fa-search me-2"></i>Find
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.2.1/html5-qrcode.min.js"></script>
    <script>
        $(document).ready(function() {
            let html5QrCode;
            const qrCodeSuccessCallback = (decodedText, decodedResult) => {
                if (decodedText) {
                    // Stop scanning
                    html5QrCode.stop();
                    
                    // Show result
                    $('#qr-reader-results').html(
                        `<div class="alert alert-success">
                            <p class="mb-1">QR Code detected:</p>
                            <p class="mb-1"><strong>${decodedText}</strong></p>
                            <p class="mb-0">Searching...</p>
                        </div>`
                    );
                    
                    // Update button states
                    $('#startButton').prop('disabled', false);
                    $('#stopButton').prop('disabled', true);
                    
                    // Redirect to find supplier by code
                    setTimeout(() => {
                        window.location.href = '@Url.Action("FindByCode", "Suppliers", new { area = "Admin" })' + '?code=' + decodedText;
                    }, 1500);
                }
            };
            
            const config = { fps: 10, qrbox: 250 };
            
            // Start scanning
            $('#startButton').click(function() {
                html5QrCode = new Html5Qrcode("qr-reader");
                html5QrCode.start(
                    { facingMode: "environment" },
                    config,
                    qrCodeSuccessCallback
                ).catch((err) => {
                    $('#qr-reader-results').html(
                        `<div class="alert alert-danger">
                            <p class="mb-0">Error starting scanner: ${err}</p>
                        </div>`
                    );
                });
                
                // Update button states
                $(this).prop('disabled', true);
                $('#stopButton').prop('disabled', false);
            });
            
            // Stop scanning
            $('#stopButton').click(function() {
                if (html5QrCode) {
                    html5QrCode.stop().then(() => {
                        $('#qr-reader-results').html(
                            `<div class="alert alert-warning">
                                <p class="mb-0">Scanner stopped</p>
                            </div>`
                        );
                        
                        // Update button states
                        $('#startButton').prop('disabled', false);
                        $(this).prop('disabled', true);
                    });
                }
            });
        });
    </script>
} 