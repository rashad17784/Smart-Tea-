@model TeaOnlineShop.Models.ViewModels.StockReconciliationCreateViewModel
@{ ViewData["Title"] = "Physical Stock Count"; }
<div class="mb-4"><h1 class="h3 mb-1">Physical Stock Count</h1><p class="text-muted mb-0">@Model.WarehouseName · enter independently observed quantities for every listed location.</p></div>
<form asp-action="Create" method="post"><input asp-for="WarehouseId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="card shadow-sm mb-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Bin</th><th>Item</th><th>System quantity</th><th style="min-width:150px">Physical count</th><th style="min-width:260px">Variance reason</th></tr></thead><tbody>
@for(var i=0;i<Model.Lines.Count;i++){<tr><td>@Model.Lines[i].BinCode</td><td><strong>@Model.Lines[i].ItemName</strong><br/><code>@Model.Lines[i].ItemCode</code><input asp-for="Lines[i].BalanceId" type="hidden"/></td><td>@Model.Lines[i].SystemQuantity</td><td><input asp-for="Lines[i].CountedQuantity" class="form-control" step="0.0001" min="0" required/><span asp-validation-for="Lines[i].CountedQuantity" class="text-danger"></span></td><td><input asp-for="Lines[i].Reason" class="form-control" placeholder="Required only when count differs"/></td></tr>}
</tbody></table></div></div><div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Submit count for approval</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
