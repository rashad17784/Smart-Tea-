@model TeaOnlineShop.Models.Dbase.StockReconciliation
@{ ViewData["Title"] = "Reconciliation Details"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Reconciliation @Model.ReconciliationNumber</h1><p class="text-muted mb-0">@Model.Warehouse.Name · counted by @Model.CreatedByName on @Model.CountedAtUtc.ToLocalTime().ToString("g")</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">Back</a></div>
<div class="card mb-4"><div class="card-body"><strong>Status:</strong> @Model.Status@if(!string.IsNullOrWhiteSpace(Model.Notes)){<div class="mt-2 text-muted" style="white-space:pre-line">@Model.Notes</div>}</div></div>
<div class="card mb-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Item</th><th>System</th><th>Counted</th><th>Difference</th><th>Reason</th><th>Ledger</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr class="@(line.Difference == 0 ? "" : "table-warning")"><td><strong>@line.ItemName</strong><br/><code>@line.ItemCode</code></td><td>@line.SystemQuantity</td><td>@line.CountedQuantity</td><td class="fw-bold">@(line.Difference > 0 ? "+" : "")@line.Difference</td><td>@line.Reason</td><td>@(line.LedgerEntryId?.ToString() ?? "—")</td></tr>}</tbody></table></div></div>
@if(Model.Status=="PendingApproval" && User.HasClaim("permission","Inventory.MasterDataManage")){<div class="card"><div class="card-body"><div class="alert alert-warning">Approval is atomic and will stop if any stock balance changed after this count.</div><div class="d-flex flex-wrap gap-2"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success" type="submit">Approve variances</button></form><form asp-action="Reject" method="post" class="d-flex gap-2 flex-grow-1"><input type="hidden" name="id" value="@Model.Id"/><input name="reason" class="form-control" required maxlength="500" placeholder="Required rejection reason"/><button class="btn btn-outline-danger" type="submit">Reject</button></form></div></div></div>}
