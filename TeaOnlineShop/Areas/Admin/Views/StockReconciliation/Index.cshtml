@model IEnumerable<TeaOnlineShop.Models.Dbase.StockReconciliation>
@{ ViewData["Title"] = "Stock Reconciliation"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Stock Reconciliation</h1><p class="text-muted mb-0">Physical counts, independently approved variances, and traceable ledger postings.</p></div>@if(User.HasClaim("permission","Inventory.Transact")){<a asp-action="Create" class="btn btn-primary"><i class="fa fa-clipboard-check me-2"></i>Start physical count</a>}</div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Reference</th><th>Counted</th><th>Warehouse</th><th>Counter</th><th>Status</th><th>Variances</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><code>@item.ReconciliationNumber</code></td><td>@item.CountedAtUtc.ToLocalTime().ToString("g")</td><td>@item.Warehouse.Name</td><td>@item.CreatedByName</td><td><span class="badge bg-secondary">@item.Status</span></td><td>@item.Lines.Count(x => x.Difference != 0)</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Review</a></td></tr>}</tbody></table></div></div>
