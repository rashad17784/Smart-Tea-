@model IEnumerable<TeaOnlineShop.Models.Dbase.Order>
@{ ViewData["Title"] = "Order Fulfilment"; var financial = User.HasClaim("permission","Dashboard.FinancialView"); }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Order Fulfilment</h1><p class="text-muted mb-0">Verified order lines, stock commitments, and controlled dispatch.</p></div><form method="get" class="d-flex gap-2"><select name="status" class="form-select"><option value="">All statuses</option><option value="Pending">Pending</option><option value="Shipped">Shipped</option></select><button class="btn btn-outline-primary">Filter</button></form></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Order</th><th>Created</th><th>Customer</th><th>Lines</th>@if(financial){<th>Total</th>}<th>Status</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td><code>@order.TransId</code></td><td>@order.CreateDate?.ToString("g")</td><td>@order.FirstName @order.LastName<br/><small class="text-muted">@order.City</small></td><td>@order.Lines.Sum(x=>x.Quantity)</td>@if(financial){<td>@order.Total?.ToString("F2")</td>}<td><span class="badge @(order.Status=="Shipped"?"bg-success":"bg-warning text-dark")">@order.Status</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div>
