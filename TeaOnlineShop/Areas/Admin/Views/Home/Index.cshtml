@{
    ViewData["Title"] = "Tea Shop Admin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fa fa-tachometer-alt me-2"></i>Admin Dashboard</h1>
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-store me-2"></i>Go to Shop
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-4 text-primary mb-3">
                        <i class="fa fa-chart-line"></i>
                    </div>
                    <h3 class="card-title">Analytics</h3>
                    <p class="card-text">View sales performance, production trends, and tea type distribution.</p>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="Dashboard" class="btn btn-primary">
                        <i class="fa fa-chart-pie me-2"></i>Go to Analytics
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-4 text-success mb-3">
                        <i class="fa fa-leaf"></i>
                    </div>
                    <h3 class="card-title">Inventory</h3>
                    <p class="card-text">Manage tea inventory items, stock levels, and check low stock alerts.</p>
                    <a asp-area="Admin" asp-controller="TeaInventory" asp-action="Index" class="btn btn-success">
                        <i class="fa fa-boxes me-2"></i>Manage Inventory
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-4 text-danger mb-3">
                        <i class="fa fa-clipboard-list"></i>
                    </div>
                    <h3 class="card-title">Reports</h3>
                    <p class="card-text">Access inventory reports, transaction logs, and export data.</p>
                    <a asp-area="Admin" asp-controller="Reports" asp-action="InventoryReport" class="btn btn-danger">
                        <i class="fa fa-file-alt me-2"></i>View Reports
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Analytics</h5>
                </div>
                <div class="card-body">
                    <div class="text-center py-4">
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Dashboard" class="btn btn-lg btn-outline-primary">
                            <i class="fa fa-chart-line me-2"></i>View Full Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a asp-area="Admin" asp-controller="TeaInventory" asp-action="LowStock" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-exclamation-triangle text-warning me-2"></i>
                                Low Stock Items
                            </div>
                            <span class="badge bg-warning rounded-pill">View</span>
                        </a>
                        <a asp-area="Admin" asp-controller="Reports" asp-action="TransactionLog" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-history text-info me-2"></i>
                                Recent Transactions
                            </div>
                            <span class="badge bg-info rounded-pill">View</span>
                        </a>
                        <a asp-area="Admin" asp-controller="Reports" asp-action="InventoryReport" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-clipboard-list text-success me-2"></i>
                                Inventory Report
                            </div>
                            <span class="badge bg-success rounded-pill">View</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- If you need any specific scripts for this dashboard -->
    <script>
        // Any client-side JS can be added here
        $(document).ready(function() {
            console.log("Admin dashboard loaded");
        });
    </script>
}

