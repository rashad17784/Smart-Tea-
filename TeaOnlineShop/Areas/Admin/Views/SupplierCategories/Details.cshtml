@model TeaOnlineShop.Models.Dbase.SupplierCategory

@{
    ViewData["Title"] = "Category Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-tags me-2"></i>Category Details</h2>
    <div>
        <a asp-area="Admin" asp-controller="SupplierCategories" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">
            <i class="fa fa-edit me-2"></i>Edit
        </a>
        <a asp-area="Admin" asp-controller="SupplierCategories" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Category Information</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">ID</div>
            <div class="col-md-9">@Model.Id</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Name</div>
            <div class="col-md-9">@Model.Name</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Description</div>
            <div class="col-md-9">
                @if (string.IsNullOrEmpty(Model.Description))
                {
                    <span class="text-muted">No description provided</span>
                }
                else
                {
                    @Model.Description
                }
            </div>
        </div>
    </div>
    <div class="card-footer bg-light">
        <a asp-area="Admin" asp-controller="SupplierCategories" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="fa fa-trash me-2"></i>Delete
        </a>
    </div>
</div> 