@model TeaOnlineShop.Models.Dbase.SupplierCategory

@{
    ViewData["Title"] = "Delete Category";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-tags me-2"></i>Delete Category</h2>
    <div>
        <a asp-area="Admin" asp-controller="SupplierCategories" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light bg-danger text-white">
        <h5 class="mb-0"><i class="fa fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-circle me-2"></i>
            Are you sure you want to delete this category? This action cannot be undone.
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">ID</div>
            <div class="col-md-9">@Model.Id</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Name</div>
            <div class="col-md-9">@Model.Name</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Description</div>
            <div class="col-md-9">
                @if (string.IsNullOrEmpty(Model.Description))
                {
                    <span class="text-muted">No description provided</span>
                }
                else
                {
                    @Model.Description
                }
            </div>
        </div>
        
        <form asp-area="Admin" asp-controller="SupplierCategories" asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash me-2"></i>Confirm Delete
                </button>
                <a asp-area="Admin" asp-controller="SupplierCategories" asp-action="Index" class="btn btn-outline-secondary ms-2">
                    <i class="fa fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div> 