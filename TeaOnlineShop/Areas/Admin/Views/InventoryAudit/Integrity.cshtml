@model TeaOnlineShop.Models.ViewModels.InventoryIntegrityViewModel
@{ ViewData["Title"] = "Inventory Integrity"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Inventory Integrity Check</h1><p class="text-muted mb-0">Cross-system reconciliation run @Model.CheckedAtUtc.ToLocalTime().ToString("g").</p></div><a asp-action="Integrity" class="btn btn-primary align-self-start"><i class="fa fa-rotate me-2"></i>Run again</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Ledger entries</small><div class="h3 mb-0">@Model.LedgerEntries</div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Location balances</small><div class="h3 mb-0">@Model.StockBalances</div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Product mappings</small><div class="h3 mb-0">@Model.ProductMappings</div></div></div></div><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Issues</small><div class="h3 mb-0">@Model.Issues.Count</div></div></div></div></div>
@if(!Model.Issues.Any()){<div class="alert alert-success"><strong>All checked inventory invariants are consistent.</strong> Product availability, aggregate item stock, and warehouse location balances agree.</div>}else{<div class="card border-warning"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Severity</th><th>Entity</th><th>Reference</th><th>Finding</th></tr></thead><tbody>@foreach(var issue in Model.Issues){<tr><td><span class="badge @(issue.Severity=="Critical"?"bg-danger":"bg-warning text-dark")">@issue.Severity</span></td><td>@issue.Entity</td><td><code>@issue.Reference</code></td><td>@issue.Message</td></tr>}</tbody></table></div></div>}
