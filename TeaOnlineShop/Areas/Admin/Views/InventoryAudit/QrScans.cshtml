@model IEnumerable<TeaOnlineShop.Models.Dbase.QRCodeScan>
@{ ViewData["Title"] = "QR Scan Audit"; }
<div class="mb-4"><h1 class="h3 mb-1">QR Scan Audit</h1><p class="text-muted mb-0">Successful and failed warehouse lookups with user, time, and source address.</p></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-sm-6 col-lg-2"><label class="form-label">From</label><input type="date" name="from" value="@ViewBag.From" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">To</label><input type="date" name="to" value="@ViewBag.To" class="form-control"/></div><div class="col-sm-6 col-lg-3"><label class="form-label">Entity type</label><input name="entityType" value="@ViewBag.EntityType" class="form-control"/></div><div class="col-sm-6 col-lg-3"><label class="form-label">Result</label><select name="successful" class="form-select"><option value="">All</option><option value="true">Successful</option><option value="false">Failed</option></select></div><div class="col-lg-2"><button class="btn btn-primary w-100" type="submit">Filter</button></div></form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Scanned</th><th>Code</th><th>Entity</th><th>Result</th><th>User</th><th>Source</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="text-nowrap">@item.ScanDateTime.ToString("g")</td><td><code>@item.QRCodeData</code></td><td>@item.EntityType #@item.EntityId</td><td><span class="badge @(item.WasSuccessful ? "bg-success" : "bg-danger")">@item.ScanResult</span><br/><small>@item.ActionTaken</small></td><td>@item.ScannedByName</td><td>@item.IpAddress<br/><small class="text-muted text-break">@item.UserAgent</small></td></tr>}</tbody></table></div></div>
