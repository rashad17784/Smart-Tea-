@model IEnumerable<TeaOnlineShop.Models.Dbase.StockLedgerEntry>
@{ ViewData["Title"] = "Immutable Stock Ledger"; }
<div class="mb-4"><h1 class="h3 mb-1">Immutable Stock Ledger</h1><p class="text-muted mb-0">Append-only movements with actor, reason, source document, and balance proof.</p></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-sm-6 col-lg-2"><label class="form-label">From</label><input type="date" name="from" value="@ViewBag.From" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">To</label><input type="date" name="to" value="@ViewBag.To" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">Item code</label><input name="itemCode" value="@ViewBag.ItemCode" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">Movement</label><input name="movementType" value="@ViewBag.MovementType" class="form-control"/></div><div class="col-lg-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Filter</button><a asp-action="ExportLedger" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-itemCode="@ViewBag.ItemCode" asp-route-movementType="@ViewBag.MovementType" class="btn btn-outline-success">Export CSV</a></div></form></div></div>
@if(ViewBag.Truncated == true){<div class="alert alert-warning">Showing the latest 500 matching entries. Export includes up to 10,000.</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Occurred</th><th>Item</th><th>Movement</th><th>Change</th><th>Balance proof</th><th>Reference</th><th>Actor / reason</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="text-nowrap">@item.OccurredAtUtc.ToLocalTime().ToString("g")</td><td><strong>@item.ItemName</strong><br/><code>@item.ItemCode</code></td><td>@item.MovementType@if(item.IsReversal){<span class="badge bg-warning text-dark ms-1">Reversal</span>}</td><td class="fw-bold @(item.QuantityChange < 0 ? "text-danger" : "text-success")">@(item.QuantityChange > 0 ? "+" : "")@item.QuantityChange</td><td>@item.PreviousStock → @item.NewStock<br/><small class="text-muted">@item.Warehouse.Code / @(item.Bin?.Code ?? "—")</small></td><td>@item.ReferenceType<br/><code>@item.ReferenceNumber</code></td><td><strong>@item.PerformedByName</strong><br/><small>@item.Reason</small></td></tr>}</tbody></table></div></div>
