@model IEnumerable<TeaOnlineShop.Models.Dbase.InventoryImportBatch>
@{
    ViewData["Title"] = "Inventory Onboarding";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3 mb-1">Inventory Onboarding</h1><p class="text-muted mb-0">Controlled opening balances with validation and dual approval.</p></div>
    <div class="d-flex gap-2"><a asp-action="Template" class="btn btn-outline-secondary"><i class="fa fa-download me-2"></i>CSV template</a><a asp-action="Upload" class="btn btn-primary"><i class="fa fa-upload me-2"></i>Submit file</a></div>
</div>
<div class="card shadow-sm"><div class="card-header"><strong>Import batches</strong></div><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Submitted</th><th>File</th><th>Status</th><th>Rows</th><th>Submitted by</th><th></th></tr></thead>
<tbody>@foreach (var item in Model) { <tr><td>@item.SubmittedAtUtc.ToLocalTime().ToString("g")</td><td>@item.FileName</td><td><span class="badge bg-secondary">@item.Status</span></td><td>@item.ValidRows valid / @item.RejectedRows rejected</td><td>@item.SubmittedByName</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Review</a></td></tr> }</tbody>
</table></div></div>
