@model TeaOnlineShop.Models.Dbase.InventoryImportBatch
@{ ViewData["Title"] = "Opening Balance Batch"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Opening Balance Batch</h1><p class="text-muted mb-0">@Model.FileName · @Model.Id</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">Back to batches</a></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Status</small><div class="fw-bold">@Model.Status</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Submitted by</small><div class="fw-bold">@Model.SubmittedByName</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Valid rows</small><div class="fw-bold">@Model.ValidRows</div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><small class="text-muted">Rejected rows</small><div class="fw-bold">@Model.RejectedRows</div></div></div></div></div>
@if (Model.Errors.Any()) { <div class="card border-danger mb-4"><div class="card-header text-danger"><strong>Validation errors</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Row</th><th>Field</th><th>Code</th><th>Message</th></tr></thead><tbody>@foreach(var error in Model.Errors){<tr><td>@error.RowNumber</td><td>@error.FieldName</td><td><code>@error.ErrorCode</code></td><td>@error.Message</td></tr>}</tbody></table></div></div> }
<div class="card mb-4"><div class="card-header"><strong>Parsed rows</strong></div><div class="table-responsive"><table class="table table-striped align-middle mb-0"><thead><tr><th>Row</th><th>Type</th><th>Item code</th><th>Quantity</th><th>Location</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.RowNumber</td><td>@row.ItemType</td><td><code>@row.ItemCode</code></td><td>@row.Quantity</td><td>@row.WarehouseCode / @row.BinCode</td><td>@row.Reason</td><td>@row.Status</td></tr>}</tbody></table></div></div>
@if (Model.Status == "PendingApproval") { <div class="card"><div class="card-body"><div class="alert alert-warning">Approval posts every row atomically. If any row fails revalidation, no stock is changed.</div><div class="d-flex flex-wrap gap-2"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success" type="submit">Approve and post</button></form><form asp-action="Reject" method="post" class="d-flex gap-2 flex-grow-1"><input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reason" required maxlength="500" placeholder="Required rejection reason"/><button class="btn btn-outline-danger" type="submit">Reject</button></form></div></div></div> }
