@model TeaOnlineShop.Models.Dbase.SupplyItem

@{
    ViewData["Title"] = "Edit Supply Item";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-edit me-2"></i>Edit Supply Item</h2>
    <div>
        <a href="/Admin/Deliveries/SupplyItems" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Item Details</h5>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        }
        
        <form asp-action="EditSupplyItem" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">Item Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Category" class="control-label">Category</label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Unit" class="control-label">Unit of Measurement</label>
                        <input asp-for="Unit" class="form-control" />
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CurrentStock" class="control-label">Current Stock</label>
                <input asp-for="CurrentStock" class="form-control" readonly aria-describedby="stockHelp" />
                <small id="stockHelp" class="form-text text-muted">Stock is controlled by receipts and audited inventory movements.</small>
                        <span asp-validation-for="CurrentStock" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MinimumStock" class="control-label">Minimum Stock Level</label>
                        <input asp-for="MinimumStock" class="form-control" />
                        <span asp-validation-for="MinimumStock" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Save Changes
                </button>
                <a href="/Admin/Deliveries/SupplyItems" class="btn btn-outline-secondary">
                    <i class="fa fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 
