@model TeaOnlineShop.Models.Dbase.SupplyItem

@{
    ViewData["Title"] = "Create Supply Item";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa fa-box-open me-2"></i>Create Supply Item</h2>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">New Supply Item Details</h5>
    </div>
    <div class="card-body">
        <form asp-action="CreateSupplyItem" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Unit" class="form-label">Unit</label>
                        <input asp-for="Unit" class="form-control" placeholder="e.g. kg, pcs, box" />
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="MinimumStock" class="form-label">Minimum Stock</label>
                        <input asp-for="MinimumStock" type="number" class="form-control" min="0" step="1" />
                        <span asp-validation-for="MinimumStock" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="CurrentStock" class="form-label">Current Stock</label>
                        <input asp-for="CurrentStock" type="number" class="form-control" value="0" min="0" step="1" />
                        <span asp-validation-for="CurrentStock" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="/Admin/Deliveries/SupplyItems" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Back to List
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Create Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 